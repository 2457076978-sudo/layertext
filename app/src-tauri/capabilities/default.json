{
  "identifier": "default",
  "description": "LayerText 默认权限：窗口基础能力、文件对话框与 AI API 访问（文件读写走自定义命令）",
  "windows": ["main", "help-usage", "help-qc", "ai-*"],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://**"
        }
      ]
    },
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging"
  ]
}
