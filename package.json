{
  "name": "layertext",
  "version": "1.2.1",
  "description": "LayerText 分层读 — 英语文本简化与审校工作台（含 MCP 质检服务）/ English text simplification & review workbench with MCP QC server",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test dist/tests/*.test.js",
    "eval": "tsc -p tsconfig.json && node dist/src/eval.js",
    "mcp": "node dist/src/mcp-server.js",
    "qc": "node dist/src/cli.js",
    "lint": "eslint app/src src tests tools --max-warnings 0",
    "lint:fix": "eslint --fix app/src src tests tools",
    "format": "prettier --write app/src src tests tools",
    "typecheck": "tsc -p tsconfig.json && cd app && tsc --noEmit -p tsconfig.json",
    "verify": "npm run preflight && npm run typecheck && npm run lint && npm test",
    "verify:rust": "cd app/src-tauri && cargo fmt --check && cargo clippy -- -D warnings && cargo test",
    "prepare": "husky",
    "fidelity": "node tools/fidelity.mjs",
    "preflight": "node tools/preflight.mjs",
    "perf:bench": "npm run build && node tools/perf_bench.mjs"
  },
  "lint-staged": {
    "*.{ts,mts,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,html}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@huggingface/transformers": "^4.2.0",
    "@tauri-apps/api": "^2.11.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.10.0",
    "fflate": "^0.8.3",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0",
    "wordnet-db": "^3.1.14"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.5.4"
  }
}
